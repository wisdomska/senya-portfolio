# Copy to .env for local development. Never commit .env.

# Absolute origin of the deployed site. Canonical tags, og:url, the sitemap,
# JSON-LD and the share-card generator all derive from this single value.
# Leave unset locally — src/data/site.ts falls back to the production URL.
PUBLIC_SITE_URL="https://wisdomska.vercel.app"

# Web3Forms access key for the contact form.
#
# This key is PUBLIC BY DESIGN. Web3Forms access keys are meant to be visible
# in client-side markup; they authorise "send a message to the inbox this key
# is bound to" and nothing else. It lives in an env var only so it can be
# rotated without editing markup — not because it is a secret.
# Get one at https://web3forms.com (free, no account required).
PUBLIC_WEB3FORMS_KEY=""
