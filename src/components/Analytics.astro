---
/**
 * Vercel Web Analytics + Speed Insights.
 *
 * Both are served from this origin by Vercel itself (/_vercel/...), so there
 * is no third-party request, no cookie, and nothing to consent to — and no npm
 * dependency either: the packages only inject these two tags.
 *
 * Production only. VERCEL_ENV is "preview" on PR deploys and undefined
 * locally, so preview traffic and local dev never report.
 */
const isProduction = process.env.VERCEL_ENV === 'production';
---

{
  isProduction && (
    <>
      <script defer src="/_vercel/insights/script.js" is:inline />
      <script defer src="/_vercel/speed-insights/script.js" is:inline />
    </>
  )
}
