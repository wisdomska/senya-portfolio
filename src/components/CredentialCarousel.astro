---
import { CREDENTIALS } from '../data/credentials';
import SectionHeading from './SectionHeading.astro';
---

<section class="band credentials" aria-labelledby="credentials-heading">
  <div class="carousel__head">
    <SectionHeading id="credentials-heading" text="hAlL of FamE" />

    <div class="carousel__controls">
      <button class="carousel__btn" type="button" aria-label="Previous credentials" data-cert-prev>
        <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M11.5 4 L6.5 9 L11.5 14"
            stroke="#e4e4e4"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button class="carousel__btn" type="button" aria-label="Next credentials" data-cert-next>
        <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M6.5 4 L11.5 9 L6.5 14"
            stroke="#e4e4e4"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="carousel__viewport">
    <ul class="carousel__track" data-cert-track>
      {
        CREDENTIALS.map((c) => (
          <li class="cert">
            <div class="cert__inner">
              <p class="cert__row">
                <span class="cert__dot" aria-hidden="true" />
                <span class="cert__type">{c.type}</span>
                <span class="cert__issued">{c.issued}</span>
              </p>
              <h3 class="cert__name">{c.name}</h3>
              <p class="cert__issuer">{c.issuer}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../scripts/carousel';
</script>
