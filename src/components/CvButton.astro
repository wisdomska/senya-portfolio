---
import { CV_PATH, CV_FILENAME } from '../data/site';

interface Props {
  /** Extra classes on the wrapper that paints the gradient hairline. */
  wrapperClass?: string;
  padded?: boolean;
}
const { wrapperClass = '', padded = false } = Astro.props;
---

<div class:list={['nav__cv', 'u-hairline', wrapperClass]}>
  <a
    class="btn--cv"
    href={CV_PATH}
    download={CV_FILENAME}
    style={padded ? 'padding: 0 18px;' : undefined}
  >
    <span>Download CV</span>
    <svg
      class="btn__icon"
      width="20"
      height="20"
      viewBox="0 0 20 20"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M10 3 V12.5 M6 9 L10 13 L14 9 M4.5 16.5 H15.5"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>
</div>
