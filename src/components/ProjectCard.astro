---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { facetsOf } from '../data/projects';

interface Props {
  project: Project;
  /** Featured cards on the home page sit on a black plate, not the grid grey. */
  variant?: 'grid' | 'featured';
  /** First two cards in a viewport get eager loading; the rest lazy. */
  eager?: boolean;
}

const { project, variant = 'grid', eager = false } = Astro.props;
const { data } = project;
const status = data.tags.find((t) => t !== 'Lab') ?? data.tags[0];
const discipline = data.lab ? `${data.category[0]} - Lab` : data.category[0];
---

<a
  class="card"
  href={`/work/${project.id}`}
  data-facets={facetsOf(project).join('|')}
  style={variant === 'featured' ? '--card-plate: #000000;' : undefined}
>
  <div class="card__cover" style={variant === 'featured' ? 'background: #000000;' : undefined}>
    <Image
      src={data.cover.src}
      alt={data.cover.alt}
      widths={[480, 768, 1024]}
      sizes="(max-width: 700px) 92vw, 44vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : undefined}
    />
    <span class="status-pill">
      <span class="status-pill__dot" aria-hidden="true"></span>
      <span>{status}</span>
    </span>
  </div>

  <div class="card__meta">
    <span class="card__title">{data.cardTitle}</span>
    <span class="card__year">{data.year}</span>
  </div>
  <span class="card__discipline">{discipline}</span>
</a>
