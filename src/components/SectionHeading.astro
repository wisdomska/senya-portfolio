---
interface Props {
  /** Rendered as authored — the display face's mixed casing is intentional. */
  text: string;
  id?: string;
  as?: 'h1' | 'h2';
  /** Extra classes, for sections that place their heading themselves. */
  class?: string;
}
const { text, id, as: Tag = 'h2', class: className } = Astro.props;
---

<Tag class:list={['section-heading', className]} id={id}>{text}</Tag>
