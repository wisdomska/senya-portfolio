---
import { TOOLS } from '../data/tools';

/**
 * The band is 144% of the section, and one pass of the eleven logos is only
 * about 86% of it. Two passes therefore leave the right-hand end empty for
 * part of every cycle. Four passes make each half of the track wider than the
 * band, so something is always on screen.
 *
 * The keyframe translates by -50%, and 44 logos divide evenly into two halves
 * of 22, so the loop still lands seamlessly.
 */
const PASSES = 4;
const sets = Array.from({ length: PASSES }, (_, i) => i);
---

<section class="marquee" aria-label="Tools I work with">
  <div class="marquee__band">
    <div class="marquee__track">
      {
        sets.map((i) => (
          <div class="marquee__set" aria-hidden={i === 0 ? undefined : 'true'}>
            {TOOLS.map((tool) => (
              <img
                class="marquee__logo"
                src={`/tools/${tool}.svg`}
                alt={i === 0 ? tool : ''}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
