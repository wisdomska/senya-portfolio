---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import MetaStrip from '../components/MetaStrip.astro';
import type { Project } from '../data/projects';
import { SITE_NAME, OWNER_NAME, SITE_URL, abs } from '../data/site';

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const p = project.data;

/**
 * Meta descriptions are kept between 120 and 155 characters. The tagline plus
 * the service line usually lands in range; short ones are topped up with the
 * scope, then with a fixed tail, and anything long is cut at a word boundary.
 */
const parts = [
  `${p.tagline}`,
  `${p.service} for ${p.client}, ${p.year}.`,
  `${p.scope}.`,
  'A case study by Senya, UI/UX designer in Accra.',
];

let description = '';
for (const part of parts) {
  if (description.length >= 120) break;
  description = description ? `${description} ${part}` : part;
}
if (description.length > 155) {
  description = description
    .slice(0, 155)
    .replace(/s+S*$/, '')
    .replace(/[,;:—-]$/, '');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.title,
  headline: p.title,
  abstract: p.tagline,
  description: p.background,
  url: abs(`/work/${project.id}`),
  image: abs(`/og/${project.id}.png`),
  dateCreated: p.year,
  genre: p.service,
  keywords: [...p.category, ...p.tags, ...p.tools].join(', '),
  about: p.industry,
  creator: {
    '@type': 'Person',
    name: OWNER_NAME,
    alternateName: 'Senya',
    url: SITE_URL,
  },
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
};
---

<BaseLayout
  title={`${p.title} — ${SITE_NAME}`}
  description={description}
  ogImage={`/og/${project.id}.png`}
  ogType="article"
  jsonLd={jsonLd}
>
  <section class="band case-hero">
    <a class="btn btn--outline case__back" href="/projects">
      <svg width="20" height="20" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path
          d="M14 9 H4 M8 5 L4 9 L8 13"
          stroke="#ffffff"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>Go Back</span>
    </a>

    <h1 class="case__title">{p.displayTitle}</h1>
    <p class="case__tagline">{p.tagline}</p>

    <MetaStrip project={project} />
  </section>

  <section class="band case-body">
    <div class="case__intro">
      <div class="case__cover">
        <Image
          src={p.cover.src}
          alt={p.cover.alt}
          widths={[480, 768, 1024]}
          sizes="(max-width: 900px) 92vw, 46vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>

      <div class="case__panel">
        <div>
          <h2 class="case__h">BACKGROUND &amp; CONTEXT</h2>
          <p class="case__p">{p.background}</p>
        </div>

        <div class="case__rule">
          <h2 class="case__h">TARGET USERS</h2>
          <ul class="case__users">
            {
              p.targetUsers.map((user) => (
                <li class="case__user">
                  <span class="case__user-badge">
                    <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <circle cx="9" cy="6.2" r="2.9" fill="#ffffff" />
                      <path d="M3.6 15c0-2.9 2.4-4.7 5.4-4.7s5.4 1.8 5.4 4.7" fill="#ffffff" />
                    </svg>
                  </span>
                  <p class="case__user-text">{user}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="case__rule">
          <h2 class="case__h">THE GOAL</h2>
          <p class="case__p">{p.goal}</p>
        </div>
      </div>
    </div>

    <div class="case__section">
      <h2 class="case__h case__h--lg">MY PROCESS</h2>
      <ol class="case__steps">
        {
          p.process.map((step) => (
            <li class="case__step">
              <span class="case__step-dot" aria-hidden="true" />
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="case__section">
      <h2 class="case__h case__h--lg">KEY DECISIONS</h2>
      <ol class="case__decisions">
        {
          p.keyDecisions.map((decision, i) => (
            <li class="case__decision">
              <span class="case__num" aria-hidden="true">
                {i + 1}
              </span>
              <span class="case__decision-text">{decision}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="case__solution">
      <div class="case__solution-inner">
        <div>
          <h2 class="case__h">THE SOLUTION</h2>
          <p class="case__p">{p.solution}</p>
        </div>

        <div class="case__rule">
          <h2 class="case__h">KEY FEATURES</h2>
          <ol class="case__features">
            {
              p.keyFeatures.map((feature, i) => (
                <li class="case__feature">
                  <span class="case__num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="case__feature-text">{feature}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="case__rule">
          <h2 class="case__h">DESIGN SYSTEM &amp; ACCESSIBILITY</h2>
          <p class="case__p">{p.designSystemNotes}</p>
        </div>
      </div>
    </div>

    <div class="case__results">
      <div class="case__result">
        <h2 class="case__h case__h--lg">OUTCOME</h2>
        <p>{p.outcome}</p>
      </div>
      <div class="case__result case__result--metric">
        <h2 class="case__h case__h--lg">BY THE NUMBERS</h2>
        <p>{p.byTheNumbers}</p>
      </div>
    </div>

    <div class="case__learned">
      <h2 class="case__learned-label">What I learned</h2>
      <p class="case__learned-text">{p.whatILearned}</p>
    </div>

    <div class="case__proto">
      <a class="btn btn--fill" href={p.prototypeUrl} target="_blank" rel="noopener noreferrer">
        <span>{p.prototypeLabel}</span>
        <svg
          class="btn__icon"
          width="20"
          height="20"
          viewBox="0 0 18 18"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M5 13 L13 5 M6.5 5 H13 V11.5"
            stroke="#111111"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <nav class="case__next" aria-label="Next project">
      <div class="case__next-col">
        <p class="case__next-label">Next project</p>
        <a class="case__next-link" href={`/work/${next.id}`}>
          <span>{next.data.title}</span>
          <svg viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path
              d="M4 9 H14 M10 5 L14 9 L10 13"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <div class="case__all">
        <a class="btn btn--outline" href="/projects">
          <span>All Projects</span>
          <svg
            class="btn__icon"
            width="20"
            height="20"
            viewBox="0 0 18 18"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 13 L13 5 M6.5 5 H13 V11.5"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </nav>
  </section>
</BaseLayout>
